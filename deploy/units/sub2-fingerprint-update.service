[Unit]
Description=Install a verified Sub2 Fingerprint GitHub release
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I -B /opt/sub2-fingerprint/update.py --web
ExecStopPost=/usr/bin/python3 -I -B /opt/sub2-fingerprint/update.py --web-finished
TimeoutStartSec=10min
UMask=0022
RuntimeDirectory=sub2-fingerprint-update
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
PrivateTmp=yes
ProtectHome=yes
NoNewPrivileges=yes
